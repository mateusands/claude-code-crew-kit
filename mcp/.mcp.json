{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "agy": {
      "command": "node",
      "args": [
        "/absolute/path/to/.claude/mcp/agy/server.mjs"
      ]
    },
    "codex": {
      "command": "node",
      "args": [
        "/absolute/path/to/.claude/mcp/codex/server.mjs"
      ]
    },
    "copilot": {
      "command": "node",
      "args": [
        "/absolute/path/to/.claude/mcp/copilot/server.mjs"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.0.4"
      ]
    }
  }
}
