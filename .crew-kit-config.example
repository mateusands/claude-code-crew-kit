# .crew-kit-config — yours, this machine, never committed

# Copy this file to `.crew-kit-config` and fill it in. It is gitignored on purpose:
# it says what YOU can reach and who YOU are, and none of that is true for the next
# person who clones this repository.
#
# The split that matters:
#
#   .crew/info.md      the project's AUTHORITY — versioned, shared, the same for
#                      everyone: who decides each gate, the red zone, the vendors
#                      already approved. A new contributor must not have to guess
#                      that touching auth needs an OK.
#
#   .crew-kit-config   YOUR ROSTER — which agents this machine actually reaches,
#                      which models are configured, and whether you are the owner
#                      or working for them.
#
# Committing the roster is how two people fight over one file every session: your
# `crew` is their `solo`, because they never installed codex. Committing the
# authority is how a new person inherits the rules instead of re-deriving them.


# ─── Who decides here, and whether that is you ────────────────────────────────
# 🔴 OWNER in this kit means WHO DECIDES — the person a gate sends you to for
# authorization. It is NOT whoever owns the repository. In your own project the
# two are the same person and the distinction never comes up; in a clone of
# someone else's they are different people, and it is the deciding one that every
# skill here means. Upstream can own the repository and decide nothing about your
# copy, and that alone is not a reason to override anything below.
#
# `.crew/info.md` names the project's OWNER. That name is versioned on purpose:
# whoever clones tomorrow has to inherit "touching auth needs an OK from X"
# rather than guess it. Unversioning authority trades a conflict for an absence,
# and an absence is silent.
#
# OWNER here OVERRIDES that name for THIS working copy, and exists because the
# versioned name can be wrong for you through no fault of anyone's:
#
#   - you forked, and the gates now say to ask a person you have never met;
#   - you cloned someone else's repository and the project's owner is upstream,
#     while the decisions about this copy are yours;
#   - you are operating on behalf of someone who is not the name in the file.
#
# 🔴 An override is DECLARED, never silent. Any report produced under one says
# both halves — "the project names X · this copy runs under Y" — the same way
# MODE reports what the project allows next to what this machine reaches.
# Redirecting "ask the owner" to yourself without saying so is how a gate stops
# existing while still appearing in the report.
#
# Leave it as it ships to use the versioned name. That is the normal case.

WHO_AM_I: <your name>
OWNER: (from .crew/info.md)     # override only when this copy has a different one
I_AM_THE_OWNER: no              # yes | no

# I_AM_THE_OWNER is the answer to "is WHO_AM_I the effective OWNER above?", and
# it is declared rather than computed because a name is not an identifier: the
# same person is "Mateus" in one file and "mateusands" in another. If the two
# lines plainly disagree with this flag, stop and ask — do not pick a reading.
#
# This is the difference between "ask the owner" and "decide" — an agent telling
# you to go ask yourself is a gate that does nothing.
#
# 🔴 No agent ever writes this file. A human fills it in. An agent that can grant
# itself authority by editing a config has no authority gate at all.


# ─── What this machine can actually reach ─────────────────────────────────────
# 🔴 Only list an agent you have installed, signed in, and seen answer. A roster
# naming an agent that is not reachable is worse than an empty one: the process
# then expects reviews that never happen, and nobody notices the absence.
#
# Check before writing it down, do not assume the MCP config implies the CLI.

ORCHESTRATOR:   claude
SECOND_COMPLEX: (none)      # the agent that reviews your work — codex, or (none)
EXECUTORS:      (none)      # agy, copilot, or (none)
BROWSER:        (none)      # playwright, or (none)


# ─── The mode that follows from the roster ────────────────────────────────────
# Not a preference — a consequence. It is the smaller of what the project allows
# and what you can reach:
#
#   solo   one agent. No cross-review exists, so self-review must be DECLARED,
#          and your host's own reviewers become the only second opinion.
#   duo    two complex agents. Full review policy, no delegation.
#   crew   two complex agents plus executors.
#
# With SECOND_COMPLEX at (none) this is solo, whatever you write here.

MODE: solo


# ─── Models actually configured here ──────────────────────────────────────────
# So a report can say which model produced what. Leave out what you do not run.

MODEL_CLAUDE:   claude-opus-5, effort high
MODEL_CODEX:    <as set in ~/.codex/config.toml>
MODEL_AGY:      <run `agy models` and pick one>
